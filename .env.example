# Copy to .env (git-ignored); mise loads it for every task.
# The workload environment `one` targets when a task does not set it itself (dev, tst, prd).
ENV_NAME="dev"
# The local AWS profile of each environment.
AWS_PROFILE_FOR_DEV="your_dev_aws_profile_name"
AWS_PROFILE_FOR_TST="your_tst_aws_profile_name"
AWS_PROFILE_FOR_PRD="your_prd_aws_profile_name"
# The local AWS profile of the devops environment, which owns the Lambda layer.
AWS_PROFILE_FOR_DEVOPS="your_devops_aws_profile_name"
