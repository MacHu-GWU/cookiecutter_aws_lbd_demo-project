// Copy to config/config-shared-secret.json5 (git-ignored) and fill in real values.
// Values shared by every environment that must not be committed, merged after
// config-shared.json5. "Secret" here means "not in git": they still go to the
// SSM parameter of each environment, as a SecureString.
{
  // The DEVOPS account that owns the Lambda layer and the artifacts bucket.
  devops_aws_account_id: "111122223333",
}
